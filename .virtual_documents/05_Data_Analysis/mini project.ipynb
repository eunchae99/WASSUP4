import statsmodels.api as sm

# 독립 변수 (학습 세션당 평균 시간)와 종속 변수 (구독 연장 여부)
X = df[['average_time_per_learning_session']]
X = sm.add_constant(X)  # 상수항 추가
y = df['target']

# 로지스틱 회귀 모델 적합
model = sm.Logit(y, X)
result = model.fit()

# 회귀 분석 결과 출력
print(result.summary())



#그럼 구독취소 그룹은 왜 각 세션당 평균 시간이 적으니 중단된 학습세션수도 높겠지?


import pandas as pd

# 데이터 로드
df_renewed = df[df['target'] == 1]
df_canceled = df[df['target'] == 0]


# 구독 연장자와 취소자의 중단된 학습 세션 수비교
renewed_abandoned_sessions = df_renewed['abandoned_learning_sessions']
canceled_abandoned_sessions = df_canceled['abandoned_learning_sessions']

# 두 그룹의 중단된 학습 세션 수 차이 분석
t_statistic, p_value = stats.ttest_ind(renewed_abandoned_sessions, canceled_abandoned_sessions)
print(f"T-statistic: {t_statistic}, P-value: {p_value}")


# 구독 연장자와 취소자의 최근 학습 성취도 비교
renewed_achievement = df_renewed['recent_learning_achievement']
canceled_achievement = df_canceled['recent_learning_achievement']

# 두 그룹의 학습 성취도 차이 분석
t_statistic, p_value = stats.ttest_ind(renewed_achievement, canceled_achievement)
print(f"T-statistic: {t_statistic}, P-value: {p_value}")


# 구독 연장자와 취소자의 월간 학습 일수 비교
renewed_active_days = df_renewed['monthly_active_learning_days']
canceled_active_days = df_canceled['monthly_active_learning_days']

# 두 그룹의 월간 학습 일수 차이 분석
t_statistic, p_value = stats.ttest_ind(renewed_active_days, canceled_active_days)
print(f"T-statistic: {t_statistic}, P-value: {p_value}")


# 구독 연장자와 취소자의 커뮤니티 참여도 비교
renewed_engagement = df_renewed['community_engagement_level']
canceled_engagement = df_canceled['community_engagement_level']

# 두 그룹의 커뮤니티 참여도 차이 분석
t_statistic, p_value = stats.ttest_ind(renewed_engagement, canceled_engagement)
print(f"T-statistic: {t_statistic}, P-value: {p_value}")


# 구독 취소 그룹과 구독 유지 그룹 간에 중단된 학습 세션 수에 유의미한 차이가 있음.


import pandas as pd
df = pd.read_csv('./data/mini.csv')
df


A = df[['user_id','abandoned_learning_sessions','target']]
A


#abandoned_learning_sessions의 값에 따라 그룹화하고 각 그룹에서 target 값의 빈도 계산
grouped = A.groupby('abandoned_learning_sessions')['target'].value_counts().unstack().fillna(0)

#각 그룹에서 '0'과 '1'의 개수 계산
grouped['total'] = grouped[0] + grouped[1]  # 총 개수
grouped['count_of_0'] = grouped[0]  # '0'인 개수
grouped['count_of_1'] = grouped[1]  # '1'인 개수

grouped[['count_of_0', 'count_of_1']]


#abandoned_learning_sessions에 대해 0과 1의 비율 계산
grouped['ratio_of_0'] = grouped['count_of_0'] / grouped[['count_of_0', 'count_of_1']].sum(axis=1)
grouped['ratio_of_1'] = grouped['count_of_1'] / grouped[['count_of_0', 'count_of_1']].sum(axis=1)

print(grouped[['ratio_of_0', 'ratio_of_1']])


import matplotlib.pyplot as plt

# 각 abandoned_learning_sessions에 대해 0과 1의 비율 계산
grouped['ratio_of_0'] = grouped['count_of_0'] / grouped[['count_of_0', 'count_of_1']].sum(axis=1)
grouped['ratio_of_1'] = grouped['count_of_1'] / grouped[['count_of_0', 'count_of_1']].sum(axis=1)

# 그래프 시각화 (막대그래프)
fig, ax = plt.subplots(figsize=(10, 6))

# 막대그래프 그리기
ax.bar(grouped.index - 0.2, grouped['ratio_of_0'], width=0.4, label='구독 취소 비율', color='blue')
ax.bar(grouped.index + 0.2, grouped['ratio_of_1'], width=0.4, label='구독 연장 비율', color='red')

# 그래프 제목 및 레이블 추가
ax.set_title('중단된 학습 세션 수에 따른 구독연장 여부의 비율')
ax.set_xlabel('중단된 학습 세션 수')
ax.set_ylabel('비율')

# x축 눈금 설정
ax.set_xticks(grouped.index)
ax.set_xticklabels(grouped.index)

# 범례 추가
ax.legend()

# 그래프 출력
plt.tight_layout()
plt.show()


