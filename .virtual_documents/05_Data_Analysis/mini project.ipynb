# 구독 연장자와 취소자의 subscription_type 비율 계산
subscription_type_ratio = df1.groupby(['target', 'subscription_type']).size().unstack(fill_value=0)

# 각 target별로 총합을 구하고 비율로 변환
subscription_type_ratio_percentage = subscription_type_ratio.div(subscription_type_ratio.sum(axis=1), axis=0)

# 결과 출력
print(subscription_type_ratio_percentage)


# 구독 연장 그룹 정의 (target이 1인 사용자들)
